---
const metrics = [
    { number: "2+", label: "Años Experiencia" },
    { number: "35%", label: "Reducción Tiempos" },
    { number: "40%", label: "+ Eficiencia" },
    { number: "4+", label: "Proyectos" },
];
---

<section class="metrics">
    <div class="container">
        <div class="metrics-grid">
            {metrics.map((metric, index) => (
                <div class="metric-item" data-aos="fade-up" data-aos-delay={index * 100}>
                    <span class="metric-number">{metric.number}</span>
                    <span class="metric-label">{metric.label}</span>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .metrics {
        background: var(--dark-light);
        border-top: 1px solid var(--glass-border);
        border-bottom: 1px solid var(--glass-border);
        padding: 3rem 0;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .metric-item {
        text-align: center;
        padding: 1.5rem;
        border-radius: 4px;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        transition: all 0.3s ease;
    }

    .metric-item:hover {
        border-color: var(--primary);
        box-shadow: 0 0 30px var(--glow-primary);
        transform: translateY(-4px);
    }

    .metric-number {
        display: block;
        font-size: 2.5rem;
        font-weight: 700;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }

    .metric-label {
        font-size: 0.8125rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-family: var(--font-mono);
    }

    @media (max-width: 768px) {
        .metrics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .metric-number {
            font-size: 2rem;
        }
    }
</style>
