---
const metrics = [
    { number: "2+", label: "Años Experiencia" },
    { number: "35%", label: "Reducción Tiempos" },
    { number: "40%", label: "+ Eficiencia" },
    { number: "5+", label: "Tecnologías" },
];
---

<section class="metrics">
    <div class="container">
        <div class="metrics-grid">
            {metrics.map((metric, index) => (
                <div class="metric-item" data-aos="fade-up" data-aos-delay={index * 100}>
                    <span class="metric-number">{metric.number}</span>
                    <span class="metric-label">{metric.label}</span>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .metrics {
        background: var(--dark-light);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 4rem 0;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2rem;
    }

    .metric-item {
        text-align: center;
        padding: 1.5rem;
        border-radius: 16px;
        background: rgba(139, 92, 246, 0.05);
        border: 1px solid rgba(139, 92, 246, 0.1);
        transition: all 0.3s ease;
    }

    .metric-item:hover {
        background: rgba(139, 92, 246, 0.1);
        border-color: rgba(139, 92, 246, 0.3);
        transform: translateY(-4px);
    }

    .metric-number {
        display: block;
        font-size: 2.5rem;
        font-weight: 700;
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.25rem;
    }

    .metric-label {
        font-size: 0.875rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    @media (max-width: 768px) {
        .metrics-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .metric-number {
            font-size: 2rem;
        }
    }
</style>
