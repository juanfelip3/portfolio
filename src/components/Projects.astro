---
const projects = [
    {
        type: "Backend · Python",
        title: "Sistema de Facturación",
        description: "Backend para facturación y control de stock con Django REST. Arquitectura SOLID, transacciones atómicas, signals y reportes JSON/PDF.",
        tech: ["Django", "DRF", "PostgreSQL", "Docker"],
        github: "https://github.com/Juanfelipe-pro/billing-service",
        demo: null
    },
    {
        type: "Backend · API REST",
        title: "API Autenticación JWT",
        description: "API REST de autenticación con Django REST Framework. CustomUser, roles/permisos, documentación Swagger, ReDoc y Scalar Docs.",
        tech: ["Django", "JWT", "Swagger", "PostgreSQL"],
        github: "https://github.com/Juanfelipe-pro/drf-auth-api",
        demo: null
    },
    {
        type: "Backend · Java",
        title: "Sistema Bancario MVC",
        description: "Aplicación bancaria en Java puro con patrón MVC. Interfaces, herencia, tipos de cuentas y manejo de transacciones.",
        tech: ["Java 17+", "MVC", "POO", "SOLID"],
        github: "https://github.com/Juanfelipe-pro/BancoApp-Java-MVC",
        demo: null
    },
];
---

<section class="section projects" id="proyectos">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-label">// Portafolio</p>
            <h2 class="section-title">Proyectos <span class="gradient-text">Backend</span></h2>
            <p class="section-subtitle">Código disponible en GitHub</p>
        </div>
        
        <div class="projects-grid">
            {projects.map((project, index) => (
                <article class="project-card" data-aos="fade-up" data-aos-delay={index * 100}>
                    <div class="project-content">
                        <span class="project-type">{project.type}</span>
                        <h3 class="project-title">{project.title}</h3>
                        <p class="project-description">{project.description}</p>
                        
                        <div class="project-tech">
                            {project.tech.map(tech => (
                                <span class="tech-badge">{tech}</span>
                            ))}
                        </div>
                        
                        <div class="project-links">
                            <a href={project.github} target="_blank" rel="noopener noreferrer" class="project-link">
                                <i class="bi bi-github"></i>
                                Ver código
                            </a>
                            {project.demo && (
                                <a href={project.demo} target="_blank" rel="noopener noreferrer" class="project-link demo">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                    Demo
                                </a>
                            )}
                        </div>
                    </div>
                    <div class="project-decoration"></div>
                </article>
            ))}
        </div>
        
        <div class="projects-cta" data-aos="fade-up">
            <a href="https://github.com/Juanfelipe-pro" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                <i class="bi bi-github"></i>
                Ver más proyectos en GitHub
            </a>
        </div>
    </div>
</section>

<style>
    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .section-subtitle {
        color: var(--text-muted);
        font-size: 1.0625rem;
    }

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .project-card {
        background: var(--dark-light);
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .project-card:hover {
        transform: translateY(-8px);
        border-color: rgba(139, 92, 246, 0.4);
        box-shadow: 0 20px 60px rgba(139, 92, 246, 0.15);
    }

    .project-decoration {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--gradient);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .project-card:hover .project-decoration {
        opacity: 1;
    }

    .project-content {
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .project-type {
        display: inline-block;
        width: fit-content;
        padding: 0.25rem 0.75rem;
        background: rgba(139, 92, 246, 0.1);
        color: var(--primary-light);
        font-size: 0.75rem;
        font-weight: 600;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-radius: 20px;
        margin-bottom: 1rem;
    }

    .project-title {
        font-size: 1.375rem;
        font-weight: 700;
        margin-bottom: 0.75rem;
    }

    .project-description {
        color: var(--text-muted);
        font-size: 0.9375rem;
        line-height: 1.7;
        flex: 1;
    }

    .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .tech-badge {
        padding: 0.25rem 0.625rem;
        background: var(--dark);
        border-radius: 6px;
        font-size: 0.75rem;
        font-family: var(--font-mono);
        color: var(--accent);
    }

    .project-links {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.25rem;
    }

    .project-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: var(--dark);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        font-size: 0.8125rem;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .project-link:hover {
        background: var(--text);
        color: var(--dark);
        border-color: var(--text);
    }

    .project-link.demo {
        background: var(--gradient);
        border-color: transparent;
        color: white;
    }

    .project-link.demo:hover {
        box-shadow: 0 4px 20px rgba(139, 92, 246, 0.4);
    }

    .projects-cta {
        text-align: center;
        margin-top: 3rem;
    }

    @media (max-width: 968px) {
        .projects-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .projects-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
