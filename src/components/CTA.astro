---
const ctaInfo = [
    { icon: "bi-check-circle-fill", text: "Disponible inmediatamente" },
    { icon: "bi-check-circle-fill", text: "Remoto o híbrido" },
    { icon: "bi-check-circle-fill", text: "Tiempo completo" },
];
---

<section class="cta-section">
    <div class="cta-bg">
        <div class="cta-gradient"></div>
    </div>

    <div class="container">
        <div class="cta-card" data-aos="fade-up">
            <div class="cta-icon">
                <i class="bi bi-rocket-takeoff"></i>
            </div>

            <h2 class="cta-title">¿Necesitas un <span class="gradient-text">Backend Developer</span>?</h2>

            <p class="cta-text">
                Estoy buscando nuevas oportunidades donde pueda aportar mis habilidades
                en Python, Django y arquitectura de software. ¡Hablemos!
            </p>

            <div class="cta-buttons">
                <a href="mailto:juanfelipealvearestrada@gmail.com" class="btn btn-primary">
                    <i class="bi bi-envelope-fill"></i>
                    Enviar Email
                </a>
                <a
                    href="https://www.linkedin.com/in/juan-felipe-alvear-estrada-399a6b388/"
                    target="_blank"
                    class="btn btn-secondary"
                >
                    <i class="bi bi-linkedin"></i>
                    LinkedIn
                </a>
            </div>

            <div class="cta-divider">
                <span>o revisa mi perfil</span>
            </div>

            <a
                href="https://www.linkedin.com/in/juan-felipe-alvear-estrada-399a6b388/"
                target="_blank"
                class="btn btn-linkedin"
            >
                <i class="bi bi-linkedin"></i>
                Ver LinkedIn
            </a>

            <div class="cta-info">
                {ctaInfo.map(item => (
                    <div class="cta-info-item">
                        <i class={`bi ${item.icon}`}></i>
                        <span>{item.text}</span>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .cta-section {
        position: relative;
        padding: 6rem 0;
        overflow: hidden;
    }

    .cta-bg {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .cta-gradient {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg,
            rgba(255, 46, 166, 0.08) 0%,
            rgba(0, 240, 255, 0.06) 50%,
            rgba(255, 204, 0, 0.04) 100%
        );
    }

    .cta-card {
        position: relative;
        max-width: 700px;
        margin: 0 auto;
        background: var(--dark-light);
        backdrop-filter: blur(20px);
        border: 1px solid var(--primary);
        border-radius: 4px;
        padding: 3rem;
        text-align: center;
        box-shadow: 0 0 60px var(--glow-primary);
    }

    .cta-icon {
        width: 80px;
        height: 80px;
        background: var(--gradient-btn);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2rem;
        color: #0A090F;
        box-shadow: 0 0 40px var(--glow-primary);
    }

    .cta-title {
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .cta-text {
        font-size: 1.125rem;
        color: var(--text-muted);
        max-width: 500px;
        margin: 0 auto 2rem;
        line-height: 1.7;
    }

    .cta-buttons {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 1.5rem;
    }

    .cta-divider {
        display: flex;
        align-items: center;
        gap: 1rem;
        color: var(--text-muted);
        font-size: 0.875rem;
        margin: 1.5rem 0;
    }

    .cta-divider::before,
    .cta-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--glass-border);
    }

    .btn-linkedin {
        background: #0077b5;
        color: white;
        border-radius: 4px;
    }

    .btn-linkedin:hover {
        background: #006396;
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(0, 119, 181, 0.4);
    }

    .cta-info {
        display: flex;
        justify-content: center;
        gap: 2rem;
        flex-wrap: wrap;
        margin-top: 2rem;
    }

    .cta-info-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.9375rem;
    }

    .cta-info-item i {
        color: var(--accent);
    }

    @media (max-width: 640px) {
        .cta-card {
            padding: 2rem 1.5rem;
        }

        .cta-buttons {
            flex-direction: column;
        }

        .cta-buttons .btn {
            width: 100%;
            justify-content: center;
        }

        .btn-linkedin {
            width: 100%;
            justify-content: center;
        }

        .cta-info {
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
        }
    }
</style>
