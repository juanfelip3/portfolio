---
const skillCategories = [
    {
        title: "Lenguajes",
        icon: "bi-code-slash",
        color: "#FF2EA6",
        skills: ["Python", "Go", "Java", "JavaScript", "SQL", "Ruby"]
    },
    {
        title: "Frameworks",
        icon: "bi-layers",
        color: "#00F0FF",
        skills: ["Django", "DRF", "FastAPI", "Node.js", "Express", "Pandas", "Polars"]
    },
    {
        title: "Bases de Datos",
        icon: "bi-database",
        color: "#FFCC00",
        skills: ["PostgreSQL", "SQLite", "Redis", "MySQL"]
    },
    {
        title: "Arquitectura",
        icon: "bi-diagram-3",
        color: "#FF2EA6",
        skills: ["Microservicios", "MVC", "SOLID", "Clean Architecture", "REST APIs"]
    },
    {
        title: "DevOps",
        icon: "bi-tools",
        color: "#00F0FF",
        skills: ["Docker", "Git / GitHub", "Celery", "n8n", "Linux"]
    },
    {
        title: "Herramientas",
        icon: "bi-kanban",
        color: "#FFCC00",
        skills: ["Swagger / OpenAPI", "JWT Auth", "pytest", "ReportLab", "Scrum / Agile"]
    },
];
---

<section class="section skills" id="habilidades">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-label">Stack Técnico</p>
            <div class="glow-line"></div>
            <h2 class="section-title">Habilidades <span class="gradient-text">Técnicas</span></h2>
        </div>

        <div class="skills-grid">
            {skillCategories.map((category, index) => (
                <div class="skill-card" data-aos="fade-up" data-aos-delay={index * 50}>
                    <div class="skill-header">
                        <i class={`bi ${category.icon}`} style={`color: ${category.color}`}></i>
                        <h3>{category.title}</h3>
                    </div>
                    <div class="skill-tags">
                        {category.skills.map(skill => (
                            <span class="skill-tag">{skill}</span>
                        ))}
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .skills {
        background: linear-gradient(180deg, var(--dark) 0%, var(--dark-light) 100%);
    }

    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .skill-card {
        background: var(--dark);
        border-radius: 4px;
        padding: 1.5rem;
        border: 1px solid var(--glass-border);
        transition: all 0.3s ease;
    }

    .skill-card:hover {
        border-color: var(--primary);
        transform: translateY(-4px);
        box-shadow: 0 0 30px var(--glow-primary);
    }

    .skill-header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .skill-header i {
        font-size: 1.25rem;
    }

    .skill-header h3 {
        font-size: 0.9375rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .skill-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .skill-tag {
        padding: 0.375rem 0.75rem;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 2px;
        font-size: 0.8125rem;
        font-weight: 500;
        transition: all 0.2s ease;
        font-family: var(--font-mono);
    }

    .skill-tag:hover {
        border-color: var(--accent);
        color: var(--accent);
        transform: translateY(-2px);
        box-shadow: 0 0 10px var(--glow-accent);
    }

    @media (max-width: 968px) {
        .skills-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 640px) {
        .skills-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
