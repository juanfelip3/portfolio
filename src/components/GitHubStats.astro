---
// GitHub username
const GITHUB_USERNAME = "Juanfelipe-pro";

// Fetch GitHub stats at build time
let githubData = {
    user: null,
    repos: [],
    languages: {},
    totalStars: 0,
    totalForks: 0
};

try {
    // Fetch user data
    const userResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}`);
    if (userResponse.ok) {
        githubData.user = await userResponse.json();
    }

    // Fetch repositories
    const reposResponse = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?per_page=100&sort=updated`);
    if (reposResponse.ok) {
        githubData.repos = await reposResponse.json();
        
        // Calculate totals and languages
        githubData.repos.forEach((repo: any) => {
            githubData.totalStars += repo.stargazers_count;
            githubData.totalForks += repo.forks_count;
            if (repo.language) {
                githubData.languages[repo.language] = (githubData.languages[repo.language] || 0) + 1;
            }
        });
    }
} catch (error) {
    console.error('Error fetching GitHub data:', error);
}

// Sort languages by count
const sortedLanguages = Object.entries(githubData.languages)
    .sort(([,a], [,b]) => (b as number) - (a as number))
    .slice(0, 6);

// Language colors
const languageColors: Record<string, string> = {
    'Python': '#3572A5',
    'Java': '#b07219',
    'JavaScript': '#f1e05a',
    'TypeScript': '#3178c6',
    'Ruby': '#701516',
    'CSS': '#563d7c',
    'HTML': '#e34c26',
    'Astro': '#ff5a03',
    'Shell': '#89e051',
    'Dockerfile': '#384d54',
};
---

<section class="section github-stats" id="github">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-label">Open Source</p>
            <div class="glow-line"></div>
            <h2 class="section-title">GitHub <span class="gradient-text">Stats</span></h2>
            <p class="section-subtitle">Estadísticas de mi actividad en GitHub</p>
        </div>
        
        <div class="github-grid">
            <!-- Profile Card -->
            <div class="github-card profile-card" data-aos="fade-up">
                <div class="profile-header">
                    <img 
                        src={githubData.user?.avatar_url || `https://github.com/${GITHUB_USERNAME}.png`} 
                        alt="GitHub Avatar"
                        class="profile-avatar"
                    />
                    <div class="profile-info">
                        <h3>{githubData.user?.name || GITHUB_USERNAME}</h3>
                        <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" class="profile-username">
                            @{GITHUB_USERNAME}
                        </a>
                    </div>
                </div>
                
                <div class="profile-stats">
                    <div class="stat">
                        <span class="stat-value">{githubData.user?.public_repos || 0}</span>
                        <span class="stat-label">Repos</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">{githubData.user?.followers || 0}</span>
                        <span class="stat-label">Followers</span>
                    </div>
                    <div class="stat">
                        <span class="stat-value">{githubData.user?.following || 0}</span>
                        <span class="stat-label">Following</span>
                    </div>
                </div>
                
                <a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" class="btn btn-secondary profile-btn">
                    <i class="bi bi-github"></i>
                    Ver perfil completo
                </a>
            </div>
            
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stats-card" data-aos="fade-up" data-aos-delay="100">
                    <div class="stats-icon">
                        <i class="bi bi-star-fill"></i>
                    </div>
                    <div class="stats-content">
                        <span class="stats-value">{githubData.totalStars}</span>
                        <span class="stats-label">Total Stars</span>
                    </div>
                </div>
                
                <div class="stats-card" data-aos="fade-up" data-aos-delay="150">
                    <div class="stats-icon forks">
                        <i class="bi bi-diagram-2-fill"></i>
                    </div>
                    <div class="stats-content">
                        <span class="stats-value">{githubData.totalForks}</span>
                        <span class="stats-label">Total Forks</span>
                    </div>
                </div>
                
                <div class="stats-card" data-aos="fade-up" data-aos-delay="200">
                    <div class="stats-icon repos">
                        <i class="bi bi-folder-fill"></i>
                    </div>
                    <div class="stats-content">
                        <span class="stats-value">{githubData.repos.length}</span>
                        <span class="stats-label">Repositorios</span>
                    </div>
                </div>
                
                <div class="stats-card" data-aos="fade-up" data-aos-delay="250">
                    <div class="stats-icon commits">
                        <i class="bi bi-git"></i>
                    </div>
                    <div class="stats-content">
                        <span class="stats-value">{Object.keys(githubData.languages).length}</span>
                        <span class="stats-label">Lenguajes</span>
                    </div>
                </div>
            </div>
            
            <!-- Languages Card -->
            <div class="github-card languages-card" data-aos="fade-up" data-aos-delay="300">
                <h4 class="card-title">
                    <i class="bi bi-code-slash"></i>
                    Lenguajes más usados
                </h4>
                <div class="languages-list">
                    {sortedLanguages.map(([lang, count]) => (
                        <div class="language-item">
                            <div class="language-info">
                                <span 
                                    class="language-dot" 
                                    style={`background-color: ${languageColors[lang] || '#8b5cf6'}`}
                                ></span>
                                <span class="language-name">{lang}</span>
                            </div>
                            <span class="language-count">{count} repos</span>
                        </div>
                    ))}
                </div>
                
                <!-- Language Bar -->
                <div class="languages-bar">
                    {sortedLanguages.map(([lang, count]) => {
                        const percentage = (count as number / githubData.repos.length) * 100;
                        return (
                            <div 
                                class="bar-segment" 
                                style={`width: ${percentage}%; background-color: ${languageColors[lang] || '#8b5cf6'}`}
                                title={`${lang}: ${percentage.toFixed(1)}%`}
                            ></div>
                        );
                    })}
                </div>
            </div>
        </div>
        
        <!-- GitHub Stats Images (fallback/additional) -->
        <div class="github-images" data-aos="fade-up">
            <img 
                src={`https://github-readme-stats.vercel.app/api?username=${GITHUB_USERNAME}&show_icons=true&theme=tokyonight&hide_border=true&bg_color=0d1117&title_color=8b5cf6&icon_color=06b6d4&text_color=f3f4f6`}
                alt="GitHub Stats"
                class="github-stats-img"
                loading="lazy"
            />
            <img 
                src={`https://github-readme-streak-stats.herokuapp.com/?user=${GITHUB_USERNAME}&theme=tokyonight&hide_border=true&background=0d1117&ring=8b5cf6&fire=06b6d4&currStreakLabel=f3f4f6`}
                alt="GitHub Streak"
                class="github-stats-img"
                loading="lazy"
            />
        </div>
    </div>
</section>

<style>
    .github-stats {
        background: var(--dark-light);
    }

    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .section-subtitle {
        color: var(--text-muted);
        font-size: 1.0625rem;
    }

    .github-grid {
        display: grid;
        grid-template-columns: 300px 1fr 300px;
        gap: 1.5rem;
        margin-bottom: 3rem;
    }

    .github-card {
        background: var(--dark);
        border-radius: 4px;
        padding: 1.75rem;
        border: 1px solid var(--glass-border);
    }

    /* Profile Card */
    .profile-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .profile-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        border: 3px solid var(--primary);
        margin-bottom: 1rem;
        box-shadow: 0 0 20px var(--glow-primary);
    }

    .profile-info h3 {
        font-size: 1.25rem;
        margin-bottom: 0.25rem;
    }

    .profile-username {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.875rem;
        transition: color 0.3s ease;
    }

    .profile-username:hover {
        color: var(--accent);
    }

    .profile-stats {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .stat {
        text-align: center;
    }

    .stat-value {
        display: block;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--accent);
    }

    .stat-label {
        font-size: 0.6875rem;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-family: var(--font-mono);
    }

    .profile-btn {
        width: 100%;
        justify-content: center;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
    }

    .stats-card {
        background: var(--dark);
        border-radius: 4px;
        padding: 1.5rem;
        border: 1px solid var(--glass-border);
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: all 0.3s ease;
    }

    .stats-card:hover {
        border-color: var(--primary);
        transform: translateY(-2px);
        box-shadow: 0 0 20px var(--glow-primary);
    }

    .stats-icon {
        width: 50px;
        height: 50px;
        background: rgba(255, 46, 166, 0.1);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: var(--primary);
    }

    .stats-icon.forks {
        background: rgba(0, 240, 255, 0.1);
        color: var(--secondary);
    }

    .stats-icon.repos {
        background: rgba(255, 204, 0, 0.1);
        color: var(--accent);
    }

    .stats-icon.commits {
        background: rgba(0, 240, 255, 0.1);
        color: var(--secondary);
    }

    .stats-value {
        display: block;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .stats-label {
        font-size: 0.8125rem;
        color: var(--text-muted);
    }

    /* Languages Card */
    .languages-card {
        display: flex;
        flex-direction: column;
    }

    .card-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        margin-bottom: 1.25rem;
    }

    .card-title i {
        color: var(--secondary);
    }

    .languages-list {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .language-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .language-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .language-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .language-name {
        font-size: 0.875rem;
        font-weight: 500;
    }

    .language-count {
        font-size: 0.75rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
    }

    .languages-bar {
        display: flex;
        height: 4px;
        border-radius: 2px;
        overflow: hidden;
        background: var(--glass-bg);
    }

    .bar-segment {
        height: 100%;
        transition: all 0.3s ease;
    }

    .bar-segment:hover {
        filter: brightness(1.3);
    }

    /* GitHub Images */
    .github-images {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .github-stats-img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
    }

    @media (max-width: 1200px) {
        .github-grid {
            grid-template-columns: 1fr 1fr;
        }

        .profile-card {
            grid-column: 1 / -1;
            flex-direction: row;
            text-align: left;
            gap: 2rem;
        }

        .profile-header {
            flex-direction: row;
            margin-bottom: 0;
        }

        .profile-stats {
            margin-bottom: 0;
        }
    }

    @media (max-width: 768px) {
        .github-grid {
            grid-template-columns: 1fr;
        }

        .profile-card {
            flex-direction: column;
            text-align: center;
        }

        .profile-header {
            flex-direction: column;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .github-images {
            flex-direction: column;
            align-items: center;
        }
    }
</style>
