---
const contacts = [
    {
        icon: "bi-envelope",
        title: "Email",
        text: "juanfelipealvearestrada@gmail.com",
        href: "mailto:juanfelipealvearestrada@gmail.com",
        color: "#FF2EA6"
    },
    {
        icon: "bi-github",
        title: "GitHub",
        text: "/juanfelip3",
        href: "https://github.com/juanfelip3",
        color: "#00F0FF"
    },
    {
        icon: "bi-linkedin",
        title: "LinkedIn",
        text: "/in/juan-felipe-alvear",
        href: "https://www.linkedin.com/in/juan-felipe-alvear-estrada-399a6b388/",
        color: "#0077b5"
    },
];
---

<section class="section contact" id="contacto">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-label">Contacto</p>
            <div class="glow-line"></div>
            <h2 class="section-title">¿Hablamos?</h2>
        </div>

        <div class="contact-grid">
            {contacts.map((contact, index) => (
                <a
                    href={contact.href}
                    target={contact.href.startsWith('mailto') ? '_self' : '_blank'}
                    rel="noopener noreferrer"
                    class="contact-card"
                    data-aos="fade-up"
                    data-aos-delay={index * 100}
                    style={`--card-color: ${contact.color}`}
                >
                    <div class="contact-icon">
                        <i class={`bi ${contact.icon}`}></i>
                    </div>
                    <h3 class="contact-title">{contact.title}</h3>
                    <p class="contact-text">{contact.text}</p>
                </a>
            ))}
        </div>
    </div>
</section>

<style>
    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        max-width: 1000px;
        margin: 0 auto;
    }

    .contact-card {
        background: var(--dark-light);
        border-radius: 4px;
        padding: 1.75rem;
        border: 1px solid var(--glass-border);
        text-align: center;
        transition: all 0.3s ease;
        display: block;
    }

    .contact-card:hover {
        border-color: var(--card-color);
        transform: translateY(-6px);
        box-shadow: 0 0 40px color-mix(in srgb, var(--card-color) 30%, transparent);
    }

    .contact-icon {
        width: 56px;
        height: 56px;
        background: color-mix(in srgb, var(--card-color) 15%, transparent);
        border: 1px solid color-mix(in srgb, var(--card-color) 30%, transparent);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        font-size: 1.5rem;
        color: var(--card-color);
        transition: all 0.3s ease;
    }

    .contact-card:hover .contact-icon {
        background: var(--card-color);
        color: #0A090F;
        box-shadow: 0 0 20px color-mix(in srgb, var(--card-color) 50%, transparent);
    }

    .contact-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.375rem;
    }

    .contact-text {
        color: var(--text-muted);
        font-size: 0.8125rem;
        word-break: break-word;
        font-family: var(--font-mono);
    }

    @media (max-width: 968px) {
        .contact-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 480px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
