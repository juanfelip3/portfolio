---
const navLinks = [
    { href: "#sobre-mi", label: "Sobre Mí" },
    { href: "#experiencia", label: "Experiencia" },
    { href: "#habilidades", label: "Habilidades" },
    { href: "#proyectos", label: "Proyectos" },
    { href: "#github", label: "GitHub" },
    { href: "#contacto", label: "Contacto" },
];
---

<nav class="navbar" id="navbar">
    <div class="container nav-container">
        <a href="#" class="logo">
            <span class="logo-bracket">&lt;</span>
            <span class="logo-text">JFA</span>
            <span class="logo-slash"> /</span>
            <span class="logo-bracket">&gt;</span>
        </a>

        <button class="mobile-toggle" id="mobileToggle" aria-label="Menu">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <div class="nav-menu" id="navMenu">
            <ul class="nav-links">
                {navLinks.map(link => (
                    <li><a href={link.href} class="nav-link">{link.label}</a></li>
                ))}
            </ul>
            <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme">
                <i class="bi bi-moon-fill icon-dark"></i>
                <i class="bi bi-sun-fill icon-light"></i>
            </button>
        </div>
    </div>
</nav>

<style>
    .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        padding: 0.875rem 0;
        background: rgba(10, 9, 15, 0.7);
        backdrop-filter: blur(20px);
        border-bottom: 1px solid transparent;
        transition: all 0.3s ease;
    }

    :global([data-theme="light"]) .navbar {
        background: rgba(245, 245, 250, 0.85);
    }

    .navbar.scrolled {
        background: rgba(10, 9, 15, 0.95);
        border-bottom-color: var(--primary);
        box-shadow: 0 0 30px var(--glow-primary);
    }

    :global([data-theme="light"]) .navbar.scrolled {
        background: rgba(245, 245, 250, 0.95);
    }

    .nav-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo {
        font-family: var(--font-mono);
        font-size: 1.375rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 1px;
    }

    .logo-bracket {
        color: var(--primary);
    }

    .logo-text {
        background: var(--gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .logo-slash {
        color: var(--secondary);
    }

    .nav-menu {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        list-style: none;
    }

    .nav-link {
        padding: 0.5rem 0.875rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-muted);
        transition: all 0.3s ease;
        position: relative;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .nav-link:hover,
    .nav-link.active {
        color: var(--accent);
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0;
        height: 2px;
        background: var(--gradient-btn);
        transition: all 0.3s ease;
        transform: translateX(-50%);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
        width: 100%;
        box-shadow: 0 0 10px var(--glow-accent);
    }

    .theme-toggle {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
        color: var(--accent);
        font-size: 1rem;
    }

    .theme-toggle:hover {
        border-color: var(--accent);
        box-shadow: 0 0 20px var(--glow-accent);
        transform: rotate(15deg);
    }

    .theme-toggle .icon-light {
        display: none;
    }

    :global([data-theme="light"]) .theme-toggle .icon-dark {
        display: none;
    }

    :global([data-theme="light"]) .theme-toggle .icon-light {
        display: inline;
    }

    .mobile-toggle {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0.5rem;
    }

    .mobile-toggle span {
        width: 24px;
        height: 2px;
        background: var(--text);
        transition: all 0.3s ease;
    }

    @media (max-width: 968px) {
        .mobile-toggle {
            display: flex;
        }

        .nav-menu {
            position: fixed;
            top: 65px;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--dark);
            flex-direction: column;
            justify-content: flex-start;
            padding: 2rem;
            gap: 2rem;
            transform: translateX(100%);
            transition: transform 0.3s ease;
        }

        :global([data-theme="light"]) .nav-menu {
            background: var(--dark);
        }

        .nav-menu.active {
            transform: translateX(0);
        }

        .nav-links {
            flex-direction: column;
            width: 100%;
        }

        .nav-link {
            width: 100%;
            padding: 1rem;
            font-size: 1.125rem;
            text-align: center;
        }

        .mobile-toggle.active span:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }

        .mobile-toggle.active span:nth-child(2) {
            opacity: 0;
        }

        .mobile-toggle.active span:nth-child(3) {
            transform: rotate(-45deg) translate(5px, -5px);
        }
    }
</style>

<script>
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
        navbar?.classList.toggle('scrolled', window.scrollY > 50);
    });

    const mobileToggle = document.getElementById('mobileToggle');
    const navMenu = document.getElementById('navMenu');

    mobileToggle?.addEventListener('click', () => {
        mobileToggle.classList.toggle('active');
        navMenu?.classList.toggle('active');
    });

    document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', () => {
            mobileToggle?.classList.remove('active');
            navMenu?.classList.remove('active');
        });
    });

    const sections = document.querySelectorAll('section[id]');
    window.addEventListener('scroll', () => {
        let current = '';
        sections.forEach(section => {
            const sectionTop = section.offsetTop;
            if (scrollY >= sectionTop - 200) {
                current = section.getAttribute('id') || '';
            }
        });
        document.querySelectorAll('.nav-link').forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href') === `#${current}`) {
                link.classList.add('active');
            }
        });
    });

    const themeToggle = document.getElementById('themeToggle');
    themeToggle?.addEventListener('click', () => {
        const html = document.documentElement;
        const current = html.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
    });
</script>
