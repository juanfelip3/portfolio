---
const experiences = [
    {
        title: "Desarrollador Full Stack",
        company: "DSOFT Innovate",
        date: "Jun 2025 – Oct 2025",
        achievements: [
            { text: "Desarrollé sistema de <strong>web crawling en Python</strong> para análisis de dominios web y extracción de información multimedia, implementando <strong>procesamiento asíncrono con Celery y Redis</strong> para manejar múltiples URLs simultáneamente." },
            { text: "Construí sistema de análisis de texto que procesa documentos y genera <strong>reportes automáticos en formato estructurado</strong>, utilizando <strong>Django REST Framework</strong> para exponer endpoints de la API." },
            { text: "Implementé <strong>arquitectura modular con componentes desacoplados</strong>, facilitando el mantenimiento y futuras extensiones del sistema." },
        ]
    },
    {
        title: "Auxiliar de Software",
        company: "Corporación Universitaria Americana · Barranquilla",
        date: "Feb 2024 – Sep 2024",
        achievements: [
            { text: "Mantuve y actualicé web services en <strong>Ruby on Rails</strong>, realizando correcciones de bugs y mejoras funcionales según requerimientos." },
            { text: "Documenté procesos de soporte y soluciones recurrentes, construyendo <strong>base de conocimiento para el equipo</strong>." },
            { text: "Resolví incidencias de acceso, funcionalidades y datos en <strong>Oracle</strong> para usuarios de la plataforma educativa." },
        ]
    },
    {
        title: "Desarrollador Web",
        company: "Corporación Universitaria Americana · Barranquilla",
        date: "Jul 2022 – Jul 2023",
        achievements: [
            { text: "Diseñé esquema de base de datos <strong>PostgreSQL</strong> y optimicé consultas SQL para módulos de gestión académica y administrativa." },
            { text: "Desarrollé aplicaciones web internas con <strong>PHP y PostgreSQL</strong>, implementando módulos CRUD y lógica de negocio para el sistema académico." },
            { text: "Colaboré en mantenimiento de código legacy, realizando correcciones de bugs y mejoras en rendimiento de consultas SQL." },
        ]
    },
];

const education = [
    {
        title: "C Piscine - Bootcamp Intensivo",
        institution: "Fundación Telefónica – Madrid",
        date: "Ago 2024 - Feb 2025",
        description: "Programación y algoritmia. Aprendizaje entre pares."
    },
    {
        title: "Técnico en Mantenimiento de Sistemas",
        institution: "Institución Universitaria ITSA",
        date: "May 2018 - Ago 2020",
        description: "Énfasis en soporte, redes y programación."
    },
];
---

<section class="section experience" id="experiencia">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-label">Trayectoria</p>
            <div class="glow-line"></div>
            <h2 class="section-title">Experiencia <span class="gradient-text">Laboral</span></h2>
            <p class="section-subtitle">Resultados medibles en cada posición</p>
        </div>

        <div class="timeline">
            {experiences.map((exp, index) => (
                <div class="timeline-item" data-aos="fade-up" data-aos-delay={index * 100}>
                    <div class="timeline-marker"></div>
                    <div class="timeline-content">
                        <div class="exp-header">
                            <div>
                                <h3 class="exp-title">{exp.title}</h3>
                                <p class="exp-company">{exp.company}</p>
                            </div>
                            <span class="exp-date">{exp.date}</span>
                        </div>
                        <ul class="exp-achievements">
                            {exp.achievements.map(achievement => (
                                <li>
                                    <i class="bi bi-check-circle-fill"></i>
                                    <span set:html={achievement.text}></span>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            ))}
        </div>

        <div class="education-section" data-aos="fade-up">
            <h3 class="education-title">
                <i class="bi bi-mortarboard"></i>
                Formación Académica
            </h3>
            <div class="education-grid">
                {education.map((edu, index) => (
                    <div class="education-card" data-aos="fade-up" data-aos-delay={index * 100}>
                        <span class="edu-date">{edu.date}</span>
                        <h4 class="edu-title">{edu.title}</h4>
                        <p class="edu-institution">{edu.institution}</p>
                        <p class="edu-description">{edu.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .experience {
        background: var(--dark-light);
    }

    .section-header {
        text-align: center;
        margin-bottom: 4rem;
    }

    .section-subtitle {
        color: var(--text-muted);
        font-size: 1.0625rem;
    }

    .timeline {
        position: relative;
        max-width: 900px;
        margin: 0 auto;
    }

    .timeline::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: linear-gradient(to bottom, var(--primary), var(--secondary), var(--accent));
    }

    .timeline-item {
        position: relative;
        padding-left: 3rem;
        padding-bottom: 3rem;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: -6px;
        top: 0;
        width: 14px;
        height: 14px;
        background: var(--primary);
        border-radius: 50%;
        box-shadow: 0 0 0 4px var(--dark-light), 0 0 0 6px var(--primary), 0 0 20px var(--glow-primary);
    }

    .timeline-content {
        background: var(--dark);
        border-radius: 4px;
        padding: 1.75rem;
        border: 1px solid var(--glass-border);
        transition: all 0.3s ease;
    }

    .timeline-content:hover {
        border-color: var(--primary);
        transform: translateX(8px);
        box-shadow: 0 0 30px var(--glow-primary);
    }

    .exp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .exp-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .exp-company {
        color: var(--secondary);
        font-weight: 500;
    }

    .exp-date {
        padding: 0.375rem 0.875rem;
        background: rgba(255, 46, 166, 0.08);
        color: var(--primary);
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 2px;
        font-family: var(--font-mono);
        border: 1px solid rgba(255, 46, 166, 0.2);
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .exp-achievements {
        list-style: none;
    }

    .exp-achievements li {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
        color: var(--text-muted);
        font-size: 0.9375rem;
        line-height: 1.6;
    }

    .exp-achievements li:last-child {
        margin-bottom: 0;
    }

    .exp-achievements i {
        color: var(--accent);
        margin-top: 0.25rem;
        flex-shrink: 0;
    }

    .exp-achievements strong {
        color: var(--text);
    }

    .education-section {
        margin-top: 4rem;
    }

    .education-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        margin-bottom: 2rem;
    }

    .education-title i {
        color: var(--secondary);
    }

    .education-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
    }

    .education-card {
        background: var(--dark);
        border-radius: 4px;
        padding: 1.5rem;
        border: 1px solid var(--glass-border);
        transition: all 0.3s ease;
    }

    .education-card:hover {
        border-color: var(--secondary);
        transform: translateY(-4px);
        box-shadow: 0 0 30px var(--glow-secondary);
    }

    .edu-date {
        display: inline-block;
        padding: 0.25rem 0.625rem;
        background: rgba(0, 240, 255, 0.06);
        color: var(--secondary);
        font-size: 0.6875rem;
        font-weight: 600;
        font-family: var(--font-mono);
        border-radius: 2px;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .edu-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }

    .edu-institution {
        color: var(--text-muted);
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
    }

    .edu-description {
        color: var(--text-muted);
        font-size: 0.875rem;
        opacity: 0.8;
    }

    @media (max-width: 768px) {
        .timeline::before {
            left: 6px;
        }

        .timeline-marker {
            left: 0;
        }

        .timeline-item {
            padding-left: 2.5rem;
        }

        .exp-header {
            flex-direction: column;
        }

        .education-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
